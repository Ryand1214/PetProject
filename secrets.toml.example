# Copy to .streamlit/secrets.toml (local) or paste into
# Streamlit Cloud > App > Settings > Secrets (hosted). Never commit the real file.
#
# SENDER: a Gmail account with 2-Step Verification on.
# App Password: https://myaccount.google.com/apppasswords  (16 chars, no spaces)
GMAIL_SENDER = "your.sender@gmail.com"
GMAIL_APP_PASSWORD = "abcdabcdabcdabcd"

# Who gets the booking email (defaults to Ryan if left out)
NOTIFY_TO = "ryandoswell123@gmail.com"

# Name shown in the app ("Notify Ryan", etc.)
OWNER_NAME = "Ryan"

# OPTIONAL: block time slots when you're already busy (exams, study, etc.)
# Google Calendar > Settings > (your calendar) > Integrate calendar >
# "Secret address in iCal format". Keep it private: anyone with it can see your events.
GCAL_ICS_URL = "https://calendar.google.com/calendar/ical/.../private-.../basic.ics"
CAL_TZ = "America/New_York"
